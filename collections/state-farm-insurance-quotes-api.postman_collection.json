          "name": "Create Renters Insurance Quote",
          "request": {
            "name": "Create Renters Insurance Quote",
            "description": {
              "content": "Request a renters insurance quote for a prospective tenant. Provide the property address, desired coverage amounts, and tenant information to receive a State Farm renters insurance quote with premium details and coverage options.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "renters",
                "quotes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
